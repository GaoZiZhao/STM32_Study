# =================================================================
# STM32CubeMX + Keil MDK-ARM 工程忽略规则
# 工程: 11_freertos_Queue_Key_Led_Irq  (STM32F411CEUx / FreeRTOS)
# 作用范围: 仅本目录及其子目录
# =================================================================

# -----------------------------------------------------------------
# 1. Keil 用户界面 / 用户选项文件
#    (记录窗口布局、断点、最近文件等，每人不同，必须忽略)
# -----------------------------------------------------------------
*.uvguix.*
*.uvgui.*
*.uvopt
*.uvoptx
*.bak
*~

# 注意: *.uvprojx (Keil 工程文件) 与 *.uvproj 是源码，必须提交，切勿忽略!

# -----------------------------------------------------------------
# 2. Keil 编译中间产物
# -----------------------------------------------------------------
*.o
*.d
*.crf
*.dep
*.axf
*.lnp
*.sct
*.map
*.lst
*.htm
*.build_log.htm
*.iex
*.i
*.cdb

# 固件镜像: 如需把 hex/bin 纳入版本管理，请注释掉下面两行
*.hex
*.bin

# -----------------------------------------------------------------
# 3. 编译输出目录
#    MDK-ARM/*/  覆盖: 工程同名输出目录、DebugConfig/、RTE/
#    (RTE 目录由 Keil 依据 .uvprojx 自动重建，无需提交)
# -----------------------------------------------------------------
MDK-ARM/*/
Objects/
Listings/
Debug/
Release/

# -----------------------------------------------------------------
# 4. 调试器 / 烧录器 运行时文件
# -----------------------------------------------------------------
JLinkLog.txt
JLinkSettings.ini
*.jflash
*.jlink
EventRecorderStub.scvd

# -----------------------------------------------------------------
# 5. STM32CubeMX 生成物 (可由 .ioc 重新生成)
#    注意: *.ioc 是工程配置源头，必须提交!
# -----------------------------------------------------------------
.mxproject

# -----------------------------------------------------------------
# 6. IDE / 编辑器 配置
# -----------------------------------------------------------------
.vscode/
.idea/
*.code-workspace
*.launch
*.project
*.cproject
.settings/

# -----------------------------------------------------------------
# 7. 操作系统 / 通用临时文件
# -----------------------------------------------------------------
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
*.swp
*.orig
*.rej

# -----------------------------------------------------------------
# 8. 代码索引 / 格式化 (个人本机配置, 不入库)
#    .clangd                  : clangd 专属配置, 个人偏好, 不上传
#    .clang-format            : clang-format 格式化规则, 个人偏好, 不上传
#    compile_commands.json    : 由 07_Tools/gen_compile_commands.py 生成,
#                               内容含本机绝对路径, 需要时重新生成即可
#    .cache/                  : clangd 后台索引缓存
#
#    注意: 此规则只影响 git, 不影响 clangd / clang-format 读取这些文件。
# -----------------------------------------------------------------
.clangd
.clang-format
compile_commands.json
.cache/

# -----------------------------------------------------------------
# 9. 白名单保护: 保留目录占位文件
# -----------------------------------------------------------------
!*.gitkeep
